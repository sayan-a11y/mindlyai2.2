# MINDLY AI Environment Configuration Example

APP_URL="http://localhost:3000"

# Supabase Backend & Realtime Database Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# OpenRouter API Keys & Models for MINDLY 2.2 Models
OPENROUTER_API_KEY_FAST="sk-or-v1-..."
OPENROUTER_MODEL_FAST="nvidia/nemotron-3.5-embed-1b:free"
OPENROUTER_MODEL_FAST_FALLBACK="nvidia/nemotron-3.5-lightning:free"

OPENROUTER_API_KEY_PRO="sk-or-v1-..."
OPENROUTER_MODEL_PRO="recursive/flint-v1.0:free"

OPENROUTER_API_KEY_THINK="sk-or-v1-..."
OPENROUTER_MODEL_THINK="google/gemma-4-26b-a4b-it:free"

OPENROUTER_API_KEY_CODING="sk-or-v1-..."
OPENROUTER_MODEL_CODING="cohere/north-mini-code:free"
OPENROUTER_API_KEY_CODING_FALLBACK="sk-or-v1-..."
OPENROUTER_MODEL_CODING_FALLBACK="recursive/flint-v1.0:free"
